{
  "name": "tisa3630-exam-practice",
  "version": "1.0.0",
  "description": "Interactive flashcard game with tit-for-tat computer opponent for TISA 3630 exam practice",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --port=8080 --open=index.html --watch=.",
    "build": "npm run copy-assets",
    "copy-assets": "mkdir -p dist && cp -r *.html *.css *.js data node_modules dist/",
    "serve": "live-server dist --port=8080",
    "start": "npm run dev",
    "netlify-dev": "netlify dev"
  },
  "keywords": [
    "flashcards",
    "game",
    "education",
    "exam-practice",
    "tit-for-tat"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "animejs": "^3.2.2",
    "swiper": "^12.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "netlify-cli": "^17.0.0"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
